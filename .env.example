# Set this to true only for a public demo preview with the Demo Owner credentials.
# Anyone with the URL can use the demo account. Set false/omit for production auth.
VITE_DEMO_MODE=true

# Required for real owner authentication and online booking notifications.
# Deploy the Spring Boot API separately, then replace with its HTTPS origin.
# Example: https://api.fieldfinder.example
VITE_API_BASE_URL=https://YOUR-FIELDFINDER-API-DOMAIN
